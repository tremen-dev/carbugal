      ],
      "parameters": {
        "fromEmail": "[REMITENTE]",
        "toEmail": "[O TEU CORREO]",
        "subject": "carbugal: o ciclo semanal parou",
        "emailFormat": "text",
        "text": "={{ 'O ciclo fallou dúas semanas seguidas e desactiveino. A web segue coa última versión boa.\\n\\nÚltima execución: ' + $('Contar fallos').item.json.execucion + '\\n\\nPara retomalo: GitHub › Actions › Ciclo semanal › Enable workflow.' }}",
        "options": {}
      },
      "credentials": {
