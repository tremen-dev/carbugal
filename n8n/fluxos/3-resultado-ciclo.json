    {
      "id": "6dec0b64-2af1-5862-a6af-3107d95b6367",
      "name": "Contar fallos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst st = $getWorkflowStaticData('global');\nst.fallos = b.resultado === 'success' ? 0 : (st.fallos || 0) + 1;\nconst i = b.informe || {};\nst.historial = [...(st.historial || []), { data: new Date().toISOString().slice(0, 10), resultado: b.resultado,\n  publicadas: (i.publicadas || []).length, retidas: (i.retidas || []).length, erros: (i.erros || []) }].slice(-8);\nreturn [{ json: { fallos: st.fallos, parar: st.fallos >= 2, execucion: b.execucion || '' } }];"
      }
    },
    {
      "id": "61dddee0-aad6-5629-b56b-72b9f3a049fc",
      "name": "2 fallos seguidos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "fe36dde0-86a0-554b-824a-6110ae45b045",
              "leftValue": "={{ $json.parar }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
