      "position": [
        0,
        600
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 1-7 * 1"
            }
          ]
        }
      }
    },
    {
      "id": "caa9cd7e-bc8f-5e18-afda-ef54a0d47423",
      "name": "Resumo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        600
      ],
      "parameters": {
        "jsCode": "const st = $getWorkflowStaticData('global');\nconst h = st.historial || [];\nif (!h.length) return [];\nconst linhas = h.map(x => `${x.data}: ${x.resultado}, ${x.publicadas} publicadas, ${x.retidas} retidas${x.erros.length ? '\\n   erros: ' + x.erros.join('; ') : ''}`);\nreturn [{ json: { texto: 'Últimos ciclos semanais de carbugal.com:\\n\\n' + linhas.join('\\n') } }];"
      }
    },
    {
      "id": "8d0b0f25-f2c5-5e81-828f-d1774600dfbf",
      "name": "Enviar resumo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        440,
        600
      ],
      "parameters": {
        "fromEmail": "[REMITENTE]",
        "toEmail": "[O TEU CORREO]",
        "subject": "carbugal: resumo mensual",
        "emailFormat": "text",
        "text": "={{ $json.texto }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "",
          "name": "SMTP avisos"
        }
      }
    }
