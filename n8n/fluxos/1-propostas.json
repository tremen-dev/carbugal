      "name": "Validar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst bin = $input.first().binary || {};\nconst lat = parseFloat(b.lat), lon = parseFloat(b.lon);\nconst ok = !!(b.nome && b.autor && bin.foto && b.licenza && !b.web)  // \"web\" é un campo trampa anti-spam\n  && lat >= 41.80 && lat <= 43.80 && lon >= -9.35 && lon <= -6.70;\nconst slug = String(b.nome || 'proposta').normalize('NFKD').replace(/[̀-ͯ]/g, '')\n  .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60);\nconst ruta = `data/propostas/fotos/${new Date().toISOString().slice(0, 10)}-${slug}.jpg`;\nconst proposta = {\n  nome: String(b.nome || '').slice(0, 120), especie: String(b.especie || '').slice(0, 80),\n  concello: String(b.concello || '').slice(0, 80), lat, lon,\n  historia: String(b.historia || '').slice(0, 2000), autor: String(b.autor || '').slice(0, 120),\n  licenza: 'CC BY-SA 4.0', terreo_privado: ['1','on','si'].includes(String(b.terreo_privado)),\n  foto_url: `https://raw.githubusercontent.com/tremen-dev/carbugal/main/${ruta}`,\n};\nlet foto64 = '';\nif (ok) foto64 = (await this.helpers.getBinaryDataBuffer(0, 'foto')).toString('base64');\nreturn [{ json: { ok, ruta, foto64, proposta } }];"
      }
    },
